# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/pv-dossier

# JWT
JWT_SECRET=change_this_to_a_long_random_string

# Email OTP (Gmail/SMTP or provider like Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="PV Dossier <no-reply@pvdossier.tn>"

# Admin
ADMIN_EMAIL=admin@example.com

# Cron (Vercel يضيفه أوتوماتيكيًا كـ Authorization header عند استدعاء الـ cron route)
CRON_SECRET=change_this_to_another_random_string
